{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kapstart",
  "compatibility_date": "2026-11-01",
  // Static site only: no Worker script, Cloudflare serves dist/ directly.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "kapstart.vapnik.de", "custom_domain": true }],
  // Preview URLs (*.workers.dev) for branch builds; the production site lives on the custom domain.
  "workers_dev": true,
  "preview_urls": true
}
