{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kapstart",
  "compatibility_date": "2026-11-01",
  // While private: Worker runs before every asset and enforces Basic Auth (TASK-68).
  // Public launch (TASK-29): delete "main" and "run_worker_first", then: wrangler secret delete AUTH_USER / AUTH_PASS.
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [{ "pattern": "kapstart.vapnik.de", "custom_domain": true }],
  // Preview URLs (*.workers.dev) for branch builds; the production site lives on the custom domain.
  "workers_dev": true,
  "preview_urls": true
}
